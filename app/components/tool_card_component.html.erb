<div id="<%= tool.id %>" class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow duration-300" data-controller="accordion">
  <div class="flex justify-between items-start mb-3">
    <h3 class="text-xl font-bold text-gray-900"><%= tool.name %></h3>
    <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium <%= category_color_class %>">
      <%= tool.category_display %>
    </span>
  </div>

  <p class="text-gray-700 mb-4"><%= tool.summary %></p>

  <div class="mb-4">
    <h4 class="text-sm font-semibold text-gray-600 mb-2">Key Metrics:</h4>
    <ul class="list-disc list-inside space-y-1">
      <% tool.metrics.each do |metric| %>
        <li class="text-sm text-gray-600"><%= metric %></li>
      <% end %>
    </ul>
  </div>

  <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded transition-colors duration-200">
    <%= tool.cta %>
  </button>
</div>
