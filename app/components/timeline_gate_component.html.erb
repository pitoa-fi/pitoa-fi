<div class="relative pl-8 pb-8 border-l-4 <%= border_color_class %> last:border-l-0 last:pb-0">
  <div class="absolute left-0 top-0 -translate-x-1/2 w-10 h-10 rounded-full <%= status_color_class %> flex items-center justify-center text-white font-bold text-xl">
    <%= status_icon %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex justify-between items-start mb-2">
      <h3 class="text-lg font-bold text-gray-900"><%= stage %></h3>
      <span class="text-sm text-gray-500"><%= date %></span>
    </div>

    <div class="mt-4">
      <h4 class="text-sm font-semibold text-gray-600 mb-2">Success Criteria:</h4>
      <ul class="space-y-1">
        <% criteria.each do |criterion| %>
          <li class="flex items-start">
            <span class="text-gray-400 mr-2">•</span>
            <span class="text-sm text-gray-700"><%= criterion %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <% if status == :in_progress %>
      <div class="mt-4 p-3 bg-blue-50 rounded-md">
        <p class="text-sm text-blue-800 font-medium">🎯 Currently in progress</p>
      </div>
    <% elsif status == :completed %>
      <div class="mt-4 p-3 bg-green-50 rounded-md">
        <p class="text-sm text-green-800 font-medium">✓ Gate passed</p>
      </div>
    <% end %>
  </div>
</div>
