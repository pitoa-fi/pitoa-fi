<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <%= link_to "← Back to All Tools", root_path, class: "text-blue-600 hover:text-blue-800 mb-6 inline-block" %>

  <div class="bg-white rounded-lg shadow-lg p-8">
    <div class="flex justify-between items-start mb-6">
      <h1 class="text-3xl font-bold text-gray-900"><%= @tool.name %></h1>
      <span class="inline-flex items-center rounded-md px-3 py-1 text-sm font-medium bg-blue-100 text-blue-800">
        <%= @tool.category_display %>
      </span>
    </div>

    <p class="text-lg text-gray-700 mb-8"><%= @tool.summary %></p>

    <div class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Key Metrics</h2>
      <ul class="space-y-3">
        <% @tool.metrics.each do |metric| %>
          <li class="flex items-start">
            <svg class="w-6 h-6 text-green-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-gray-700"><%= metric %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="border-t pt-6">
      <button class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-6 rounded-lg transition-colors duration-200">
        <%= @tool.cta %>
      </button>
    </div>
  </div>
</div>
