<div class="space-y-6">

  <!-- Landing Page Checklist -->
  <div class="bg-white rounded-2xl p-6 border-2 border-gray-200 shadow-lg">
    <h3 class="text-xl font-bold text-gray-900 mb-4">Landing Page Checklist</h3>

    <div class="space-y-4">
      <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-xl">
        <input type="checkbox" class="mt-1 w-5 h-5 text-blue-600 rounded">
        <div class="flex-1">
          <h4 class="font-bold text-gray-900">Clear, Benefit-Driven Headline</h4>
          <p class="text-sm text-gray-600 mt-1">States what you do and why it matters in &lt;10 words</p>
          <p class="text-xs text-gray-500 mt-1 italic">Example: "Find and hire pre-vetted React developers in 48 hours"</p>
        </div>
      </div>

      <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-xl">
        <input type="checkbox" class="mt-1 w-5 h-5 text-blue-600 rounded">
        <div class="flex-1">
          <h4 class="font-bold text-gray-900">Subheadline Explaining How</h4>
          <p class="text-sm text-gray-600 mt-1">Expand on the headline with specific mechanism</p>
          <p class="text-xs text-gray-500 mt-1 italic">Example: "Skip the recruiting hassle. Browse profiles, message candidates, and start interviews today."</p>
        </div>
      </div>

      <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-xl">
        <input type="checkbox" class="mt-1 w-5 h-5 text-blue-600 rounded">
        <div class="flex-1">
          <h4 class="font-bold text-gray-900">Hero Image or Demo Video</h4>
          <p class="text-sm text-gray-600 mt-1">Show the product in action (screenshots, mockup, or short video)</p>
        </div>
      </div>

      <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-xl">
        <input type="checkbox" class="mt-1 w-5 h-5 text-blue-600 rounded">
        <div class="flex-1">
          <h4 class="font-bold text-gray-900">Problem Statement</h4>
          <p class="text-sm text-gray-600 mt-1">Call out the pain point they're experiencing right now</p>
          <p class="text-xs text-gray-500 mt-1 italic">Example: "Tired of sifting through 200 resumes for every developer role?"</p>
        </div>
      </div>

      <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-xl">
        <input type="checkbox" class="mt-1 w-5 h-5 text-blue-600 rounded">
        <div class="flex-1">
          <h4 class="font-bold text-gray-900">3 Key Benefits (Not Features)</h4>
          <p class="text-sm text-gray-600 mt-1">Focus on outcomes: Save time, make money, reduce stress</p>
        </div>
      </div>

      <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-xl">
        <input type="checkbox" class="mt-1 w-5 h-5 text-blue-600 rounded">
        <div class="flex-1">
          <h4 class="font-bold text-gray-900">Social Proof</h4>
          <p class="text-sm text-gray-600 mt-1">Testimonials, logos, metrics ("Used by 50+ startups"), or press mentions</p>
        </div>
      </div>

      <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-xl">
        <input type="checkbox" class="mt-1 w-5 h-5 text-blue-600 rounded">
        <div class="flex-1">
          <h4 class="font-bold text-gray-900">Single, Clear Call-to-Action</h4>
          <p class="text-sm text-gray-600 mt-1">One button, action-oriented: "Start Free Trial", "Get Early Access", "Join Waitlist"</p>
        </div>
      </div>

      <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-xl">
        <input type="checkbox" class="mt-1 w-5 h-5 text-blue-600 rounded">
        <div class="flex-1">
          <h4 class="font-bold text-gray-900">Minimal Form Fields</h4>
          <p class="text-sm text-gray-600 mt-1">Email only. Add fields later after you have traction.</p>
        </div>
      </div>

      <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-xl">
        <input type="checkbox" class="mt-1 w-5 h-5 text-blue-600 rounded">
        <div class="flex-1">
          <h4 class="font-bold text-gray-900">Mobile Responsive</h4>
          <p class="text-sm text-gray-600 mt-1">50%+ of traffic is mobile. Test on your phone.</p>
        </div>
      </div>

      <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-xl">
        <input type="checkbox" class="mt-1 w-5 h-5 text-blue-600 rounded">
        <div class="flex-1">
          <h4 class="font-bold text-gray-900">Analytics Installed</h4>
          <p class="text-sm text-gray-600 mt-1">Google Analytics, Mixpanel, or Simple Analytics to track visitors and conversions</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Build Tools -->
  <div class="grid md:grid-cols-3 gap-4">
    <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl p-6 text-white">
      <h4 class="font-bold mb-2">🚀 Carrd</h4>
      <p class="text-sm text-blue-100 mb-3">Simple one-page sites in minutes. Perfect for landing pages.</p>
      <p class="text-xs text-blue-200">Free • carrd.co</p>
    </div>

    <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl p-6 text-white">
      <h4 class="font-bold mb-2">🎨 Webflow</h4>
      <p class="text-sm text-purple-100 mb-3">No-code designer. More flexibility, steeper learning curve.</p>
      <p class="text-xs text-purple-200">Free tier • webflow.com</p>
    </div>

    <div class="bg-gradient-to-br from-green-500 to-green-600 rounded-xl p-6 text-white">
      <h4 class="font-bold mb-2">📝 Notion + Super</h4>
      <p class="text-sm text-green-100 mb-3">Write in Notion, publish as fast site with Super.</p>
      <p class="text-xs text-green-200">$12/mo • super.so</p>
    </div>
  </div>

  <!-- Launch Strategy -->
  <div class="bg-gradient-to-br from-orange-50 to-red-50 rounded-2xl p-6 border-2 border-orange-200">
    <h3 class="text-xl font-bold text-gray-900 mb-4">Launch Strategy</h3>
    <div class="space-y-3">
      <div class="flex items-start space-x-3">
        <div class="flex-shrink-0 w-8 h-8 bg-orange-500 text-white rounded-full flex items-center justify-center font-bold">1</div>
        <div>
          <h4 class="font-bold text-gray-900">Build in 1 Day</h4>
          <p class="text-sm text-gray-600">Don't overthink it. Ship a simple page and iterate based on feedback.</p>
        </div>
      </div>

      <div class="flex items-start space-x-3">
        <div class="flex-shrink-0 w-8 h-8 bg-orange-500 text-white rounded-full flex items-center justify-center font-bold">2</div>
        <div>
          <h4 class="font-bold text-gray-900">Share with 10 People</h4>
          <p class="text-sm text-gray-600">Send to potential customers (not friends/family). Ask for honest feedback.</p>
        </div>
      </div>

      <div class="flex items-start space-x-3">
        <div class="flex-shrink-0 w-8 h-8 bg-orange-500 text-white rounded-full flex items-center justify-center font-bold">3</div>
        <div>
          <h4 class="font-bold text-gray-900">Run Small Paid Test</h4>
          <p class="text-sm text-gray-600">Spend $50-100 on Facebook/Google ads. See if anyone actually clicks and signs up.</p>
        </div>
      </div>

      <div class="flex items-start space-x-3">
        <div class="flex-shrink-0 w-8 h-8 bg-orange-500 text-white rounded-full flex items-center justify-center font-bold">4</div>
        <div>
          <h4 class="font-bold text-gray-900">Measure & Iterate</h4>
          <p class="text-sm text-gray-600">Track conversion rate. If &lt;2%, test new headlines/copy. If &gt;5%, double down.</p>
        </div>
      </div>
    </div>
  </div>

</div>
